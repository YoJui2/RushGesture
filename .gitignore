# Entorno
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secretos (nunca versionar)
.env
.env.*
!.env.example

# Datos y artefactos
# El demo versiona el dataset, el modelo y los informes finales para que un
# clon funcione sin reentrenar. Los archivos temporales/sinteticos se ignoran.
data/*.csv
!data/landmarks.csv
data/*.parquet
data/_tmp*
models/*.joblib
!models/gesture_model.joblib
models/*.pkl
models/*.json
!models/gesture_model.json
models/synthetic_*
reports/*.png
!reports/confusion_matrix.png
!reports/cv_confusion_matrix.png
reports/*.txt
reports/*.json
!reports/cv_summary.json
reports/synthetic_*

# Artefactos de la campana anterior (vocabulario de 5 clases). Se conservan
# localmente como referencia al empezar una recoleccion nueva; la evidencia
# historica queda en el historial de git.
data/legacy/
models/legacy/
reports/legacy/
assets/*.task
!assets/hand_landmarker.task

# Paquete de artefactos para transferir entre maquinas
gesture_rush_artifacts.zip

# Editor
.vscode/
.idea/
*.swp
